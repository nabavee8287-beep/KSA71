{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/",
      "dest": "/Index.html"
    },
    {
      "src": "/index.html",
      "dest": "/Index.html"
    },
    {
      "src": "/local_preview.html",
      "dest": "/local_preview.html"
    },
    {
      "src": "/(.*)",
      "dest": "/Index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
